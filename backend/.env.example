# ===============================================
# homelab-agent backend — configurazione esempio
# Copia questo file in .env e compila i valori.
# ===============================================       

# --- Sicurezza ---
# Chiave richiesta negli header X-API-Key per tutti gli endpoint protetti.
# Genera una chiave sicura con: openssl rand -hex 32
API_SECRET_KEY=change-me
# Imposta a 1 SOLO per sviluppo locale senza chiave (disabilita il fail-fast al boot).
ALLOW_INSECURE=0
# Origini CORS ammesse (separate da virgola). Includi lo schema completo
# (http/https) di ogni origine da cui il frontend accede all'API,
# es. dominio Nginx Proxy Manager: https://agent.example.local
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Rate limiting endpoint chat/stream.
RATE_LIMIT=30/minute

# --- MetaMCP ---
# Endpoint Streamable HTTP del namespace MetaMCP (SDK MCP ufficiale).
METAMCP_URL=http://metamcp.example.local:12008/metamcp/MetaMCP/mcp
METAMCP_API_KEY=sk_mt_change-me

# --- LLM (OpenAI-compatible) ---
DEFAULT_MODEL=my-model
LLAMA_CPP_URL=http://llm.example.local:8080/v1
# Provider Ollama opzionale (vuoto: disattivato)
# OLLAMA_URL=http://ollama.example.local:11434
# Il campionamento non si configura qui: lo decide il profilo di ragionamento del modello (app/llm/reasoning.py)
# Caratteri di ogni risultato di tool ripetuti nei passi di selezione (la sintesi finale li riceve interi)
# AGENT_OBSERVATION_LIMIT=4000

# --- Storage ---
# Directory unica dei dati (database, memoria, artefatti, upload, knowledge base).
# Default: <repo>/data in locale; nei compose è /data (volume agent_data).
# DATA_DIR=/data
TRUNCATION_LIMIT=40000
# Scheduler delle automazioni (0 lo disattiva, per esempio nei test)
# ENABLE_AUTOMATION_SCHEDULER=1

# Metriche (data/metrics.db): campione di salute dei servizi ogni N secondi (0 lo disattiva), conservazione in giorni
# METRICS_SAMPLE_INTERVAL_S=60
# METRICS_RETENTION_DAYS=30
# Ora (0-23, fuso del container: UTC salvo TZ) del consolidamento giornaliero della memoria (messaggi -> fatti); -1 = solo su richiesta
# MEMORY_CONSOLIDATION_HOUR=3

# --- SearXNG (ricerca web, opzionale) ---
SEARXNG_URL=http://searxng.example.local:8080
# SEARXNG_ENGINES=google,bing,duckduckgo,brave,startpage
# SEARCH_PRIMARY_LANG=en
# SEARCH_FALLBACK_LANG=it

# Endpoint HTTP (o Unix socket) per contattare l'API di Firecracker.
FIRECRACKER_API_URL=http://CHANGE_ME:8080
# Log della console della microVM
# FIRECRACKER_LOG_URL=http://CHANGE_ME:8081/console.log

# Percorso ASSOLUTO al kernel guest (vmlinux) sul server (host Proxmox).
FIRECRACKER_KERNEL_PATH=/opt/firecracker/vmlinux.bin

# Percorso ASSOLUTO all'immagine rootfs guest (ext4) sul server (host Proxmox).
FIRECRACKER_ROOTFS_PATH=/opt/firecracker/rootfs.ext4
