# ===============================================
# homelab-agent backend — configurazione esempio
# Copia questo file in .env e compila i valori.
# ===============================================       

# --- Sicurezza ---
# Chiave richiesta negli header X-API-Key per tutti gli endpoint protetti.
# Genera una chiave sicura con: openssl rand -hex 32
API_SECRET_KEY=change-me
# Imposta a 1 SOLO per sviluppo locale senza chiave (disabilita il fail-fast al boot).
ALLOW_INSECURE=0
# Origini CORS ammesse (separate da virgola). Includi lo schema completo
# (http/https) di ogni origine da cui il frontend accede all'API,
# es. dominio Nginx Proxy Manager: https://agent.example.local
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Rate limiting endpoint chat/stream.
RATE_LIMIT=30/minute

# --- MetaMCP ---
# Endpoint Streamable HTTP del namespace MetaMCP (SDK MCP ufficiale).
METAMCP_URL=http://metamcp.example.local:12008/metamcp/MetaMCP/mcp
METAMCP_API_KEY=sk_mt_change-me

# --- LLM (OpenAI-compatible) ---
# Modello delle richieste che non ne indicano uno. Vuoto = quello caricato sul server, altrimenti il primo della lista
# DEFAULT_MODEL=my-model
LLAMA_CPP_URL=http://llm.example.local:8080/v1
# Watchdog delle risorse: dice quali modelli si possono usare. Vuoto = disattivato. Se non risponde, nessuna restrizione
# WATCHDOG_URL=http://watchdog.example.local:8080
# Provider Ollama opzionale (vuoto: disattivato)
# OLLAMA_URL=http://ollama.example.local:11434
# Livello di sensibilità più alto che ogni provider può ricevere: public, internal, private (default private).
# Abbassalo a internal se l'indirizzo porta a un servizio cloud, anche attraverso un proxy locale.
# LLAMA_CPP_CLEARANCE=private
# OLLAMA_CLEARANCE=private
# Provider cloud AWS Bedrock (opzionale). Esiste solo con una chiave API OPPURE le credenziali AWS, la regione e almeno
# un modello: altrimenti è spento e nulla cambia. Se ci sono entrambe, vince la chiave API.
# Chiave API di Bedrock (autenticazione Bearer):
# BEDROCK_API_KEY=change-me
# In alternativa, credenziali AWS (firma SigV4), meglio dedicate: bedrock:InvokeModel* sui modelli ammessi, più
# bedrock:ListFoundationModels e bedrock:ListInferenceProfiles per "Cerca modelli" (PROVIDERS_DESIGN.md 5.8.8):
# AWS_ACCESS_KEY_ID=change-me
# AWS_SECRET_ACCESS_KEY=change-me
# AWS_SESSION_TOKEN=
# Regione dell'endpoint bedrock-runtime (obbligatoria):
# AWS_REGION=us-east-1
# Modelli offerti, separati da virgola (l'endpoint non ha un elenco): identificativi Bedrock o profili di inferenza
# BEDROCK_MODELS=model-id-1,model-id-2
# Livello più alto che Bedrock può ricevere: public (default) o internal. `private` non è ammesso da qui.
# BEDROCK_CLEARANCE=public
# Il campionamento non si configura qui: lo decide il profilo di ragionamento del modello (app/llm/reasoning.py)
# Caratteri di ogni risultato di tool ripetuti nei passi di selezione (la sintesi finale li riceve interi)
# AGENT_OBSERVATION_LIMIT=4000
# Pensiero dei passi precedenti nell'agent loop: auto (dal profilo del modello), on, off
# AGENT_INTERLEAVED_THINKING=auto

# --- Canali (Telegram e simili) ---
# Indirizzo della Web UI per i link alle conversazioni che i canali mandano (<url>/c/<thread>): scrivilo solo qui.
# Vuoto = nessun link, i canali dicono di aprire l'app
# WEB_UI_URL=https://agent.example.local
# Secondi che un canale aspetta la fine del turno prima di dire che la risposta sarà nell'app (il turno continua)
# CHANNEL_REPLY_TIMEOUT_SECONDS=300
# Telegram (long polling, nessuna porta aperta). Token del bot da BotFather; vuoto = canale spento
# TELEGRAM_BOT_TOKEN=
# Id numerici degli utenti ammessi, separati da virgola: obbligatoria con il token (senza, il canale non parte)
# TELEGRAM_ALLOWED_USERS=
# Livello consegnato senza conferma: public o internal (default). `private` arriva solo con "Mostra qui"
# TELEGRAM_CLEARANCE=internal

# --- Storage ---
# Directory unica dei dati (database, memoria, artefatti, upload, knowledge base).
# Default: <repo>/data in locale; nei compose è /data (volume agent_data).
# DATA_DIR=/data
TRUNCATION_LIMIT=40000
# Scheduler delle automazioni (0 lo disattiva, per esempio nei test)
# ENABLE_AUTOMATION_SCHEDULER=1

# Metriche (data/metrics.db): campione di salute dei servizi ogni N secondi (0 lo disattiva), conservazione in giorni
# METRICS_SAMPLE_INTERVAL_S=60
# METRICS_RETENTION_DAYS=30

# --- SearXNG (ricerca web, opzionale: vuoto = disattivata) ---
SEARXNG_URL=http://searxng.example.local:8080
# SEARXNG_ENGINES=google,bing,duckduckgo,brave,startpage
# SEARCH_PRIMARY_LANG=en
# SEARCH_FALLBACK_LANG=it

# Endpoint HTTP (o Unix socket) per contattare l'API di Firecracker.
FIRECRACKER_API_URL=http://firecracker.example.local:8080
# Log della console della microVM
# FIRECRACKER_LOG_URL=http://firecracker.example.local:8081/console.log

# Percorso ASSOLUTO al kernel guest (vmlinux) sul server (host Proxmox).
FIRECRACKER_KERNEL_PATH=/opt/firecracker/vmlinux.bin

# Percorso ASSOLUTO all'immagine rootfs guest (ext4) sul server (host Proxmox).
FIRECRACKER_ROOTFS_PATH=/opt/firecracker/rootfs.ext4
